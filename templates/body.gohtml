{{define "body"}}
<header>
    <div style="display: flex; justify-content: center; align-items: center; flex-direction:column;">
        <img src="/assets/images/world_logo.gif" />
        <h1>World Sayings</h1>
    </div>
</header>
<main>
    <section>
        <article id="newSaying">
            <form
                method="post"
                id="newSayingForm"
                hx-post="/saying"
                hx-target="#sayingsList"
                hx-swap="innerHTML">

                <label>
                    Original
                    <input name="original" required>
                    <small id="original-validator"></small>
                </label>
                <label>
                    Translated
                    <input name="translated" required>
                    <small id="translated-validator"></small>
                </label>
                <label>
                    Meaning
                    <input name="meaning" required>
                    <small id="meaning-validator"></small>
                </label>
                <label>
                    When to Use
                    <input name="whentouse">
                    <small id="whentouse-validator"></small>
                </label>
                <label>
                    Tags:
                    <button id="addTag">+</button>
                </label>

                <input type="submit" value="Submit Saying"/>
            </form>
        </article>
    </section>
    <section id="sayingsList">
        {{block "sayingsList" .}}{{end}}
    </section>
</main>
<footer>

</footer>
{{end}}
